<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- The local Expo module's library manifest is the source of truth for the
       foreground service and its permissions (spec 33.6), not a generated app manifest
       which a clean `expo prebuild` would recreate. -->

  <!-- Foreground service: connectedDevice is the intended primary type (spec 14.2 — the
       phone maintains a network connection to the paired desktop). The network
       permissions below satisfy its runtime prerequisites; Play-policy validation is
       spike 7. POST_NOTIFICATIONS is the Android 13+ runtime permission (spec 14.4);
       WAKE_LOCK backs the partial wake lock held only while transferring (spec 14.6). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

  <application>
    <service
      android:name="expo.modules.foldersync.FolderSyncService"
      android:exported="false"
      android:foregroundServiceType="connectedDevice" />
  </application>
</manifest>
